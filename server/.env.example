NODE_ENV=development
PORT=5000

# Put your MongoDB Atlas URI below. Replace <password> with your actual password.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hydroseed?retryWrites=true&w=majority

# JWT Token
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_EXPIRES_IN=90d
